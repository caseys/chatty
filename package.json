{
  "name": "chatty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first fully client-side browser voice assistant",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "replay": "REPLAY_REPORT=1 vitest run tests/replay.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@litert-lm/core": "0.19.0-nightly.20261016",
    "@mlc-ai/web-llm": "^0.2.85",
    "@realtimex/piper-tts-web": "^1.1.1",
    "acorn": "^8.19.0",
    "acorn-loose": "^8.5.2",
    "cactus-needle": "^0.3.0",
    "onnxruntime-web": "^1.30.0",
    "prismjs": "^1.30.0",
    "webaudio-tinysynth": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/prismjs": "^1.26.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
